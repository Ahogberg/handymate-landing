{
  "version": 2,
  "builds": [
    {
      "src": "*.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/partners",
      "dest": "/partners.html"
    },
    {
      "src": "/jamfor",
      "dest": "/jamfor.html"
    },
    {
      "src": "/",
      "dest": "/index.html"
    }
  ]
}
